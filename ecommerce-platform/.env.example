# =============================================================
# ECOMMERCE PLATFORM — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to version control.
# =============================================================


# -------------------------------------------------------------
# REQUIRED — app will not start correctly without these
# -------------------------------------------------------------

# JWT secret: Base64-encoded, minimum 256 bits (32 bytes)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# First admin account — created automatically on first startup
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=


# -------------------------------------------------------------
# PAYMENT — fill in at least one provider
# -------------------------------------------------------------

# Paystack (Nigeria / Africa)
# Get keys from: https://dashboard.paystack.com/#/settings/developers
# Test card: 4084084084084081  CVV: 408  PIN: 0000  OTP: 123456
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...


# -------------------------------------------------------------
# EMAIL / SMTP — for order confirmations and OTP emails
# -------------------------------------------------------------

# Gmail (use an App Password, not your real password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_AUTH=true
SMTP_STARTTLS=true

# Brevo — free alternative (300 emails/day)
# https://app.brevo.com/settings/keys/smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-brevo-login-email
# SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_AUTH=true
# SMTP_STARTTLS=true


# -------------------------------------------------------------
# DATABASE — default passwords used by docker-compose
# Change these before deploying to a server
# -------------------------------------------------------------
POSTGRES_USER_PASSWORD=user_pass
POSTGRES_PRODUCT_PASSWORD=product_pass
POSTGRES_ORDER_PASSWORD=order_pass
POSTGRES_PAYMENT_PASSWORD=payment_pass
POSTGRES_ADMIN_PASSWORD=admin_pass


# -------------------------------------------------------------
# PGADMIN — database admin UI
# Remove the pgadmin service from docker-compose in production
# -------------------------------------------------------------
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=


# -------------------------------------------------------------
# PORT OVERRIDES — optional, defaults shown
# -------------------------------------------------------------

# FRONTEND_PORT=80
# API_GATEWAY_PORT=8080
# EUREKA_PORT=8761
# CONFIG_SERVER_PORT=8888
# USER_SERVICE_PORT=8081
# PRODUCT_SERVICE_PORT=8082
# CART_SERVICE_PORT=8083
# ORDER_SERVICE_PORT=8084
# PAYMENT_SERVICE_PORT=8085
# ADMIN_SERVICE_PORT=8086
# NOTIFICATION_SERVICE_PORT=8087

