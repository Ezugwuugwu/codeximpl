# JWT Secret — must be a Base64-encoded 256-bit (32-byte) random key.
# Generate a new one with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# or:
#   openssl rand -base64 32
JWT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Paystack — get keys from https://dashboard.paystack.com/#/settings/developers
# Use test keys (sk_test_... / pk_test_...) for development.
# Test card: 4084084084084081  CVV: 408  Expiry: any future  PIN: 0000  OTP: 123456
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# First admin account — seeded automatically on user-service startup.
# Set both values; leave blank to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=

SPRING_PROFILES_ACTIVE=docker
API_GATEWAY_PORT=8080
FRONTEND_PORT=5173
SMTP_PORT=1025
MAILHOG_UI_PORT=8025
